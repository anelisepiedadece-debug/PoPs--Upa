{
  "name": "pops-upa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "test:e2e": "node --experimental-strip-types scripts/run-e2e.ts",
    "format": "prettier --write app components lib scripts tests *.json *.ts *.mjs README.md",
    "format:check": "prettier --check app components lib scripts tests *.json *.ts *.mjs README.md",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
