# Local development needs no external account or key.
POPS_BACKEND=local
POPS_DATA_DIR=./data
POPS_SEED_DEMO=true
# Internet deployment: set POPS_BACKEND=supabase in the hosting dashboard.
# SUPABASE_URL is the HTTPS project URL, e.g. https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is a private server key (never NEXT_PUBLIC_).
# ADMIN_SETUP_CODE: generate a private random activation code, 32 to 256 chars.
# ADMIN_LOGIN / ADMIN_PASSWORD are used only by admin:create.
# Never commit passwords, keys, institutional databases or PDFs.
