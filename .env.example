# Node.js >= 24. Dados e PDFs precisam de disco persistente.
POPS_DATA_DIR=./data
# false para não criar documentos de exemplo em um banco novo.
POPS_SEED_DEMO=true
# ADMIN_LOGIN / ADMIN_PASSWORD são usados apenas pelo comando admin:create.
# ADMIN_SETUP_CODE libera o primeiro acesso pela tela: segredo de 32 a 256 caracteres.
# Gere e configure esse código de forma privada no servidor.
# Não salve senhas no repositório. Não há senha padrão.
